# Plantilla de secrets para el despliegue publico de alerta_incendios en Streamlit Community
# Cloud. Copia este archivo a `secrets.toml` (mismo directorio) para probar en local, o pega su
# contenido en el panel "Secrets" de Streamlit Cloud. `secrets.toml` real esta en .gitignore -
# nunca lo commitees.
#
# En el despliegue publico NO hace falta ninguna credencial de base de datos: la app lee los
# ranchos/clientes de un snapshot local (ver RANCHOS_DATA_SOURCE mas abajo y
# scripts/exportar_snapshot.py), no consulta la BD de produccion en vivo.

# Fuerza el modo snapshot (sin esto, por defecto intenta conectar a la BD en vivo)
RANCHOS_DATA_SOURCE = "snapshot"

# Cuenta de servicio de Google Earth Engine - necesaria porque el servidor desplegado no puede
# hacer `earthengine authenticate` de forma interactiva. Crear en Google Cloud Console > IAM >
# Cuentas de servicio, con el rol "Earth Engine Resource Viewer" sobre el proyecto GEE_PROJECT,
# y generar una clave JSON.
GEE_SERVICE_ACCOUNT_EMAIL = "alerta-incendios@tu-proyecto.iam.gserviceaccount.com"
GEE_SERVICE_ACCOUNT_KEY_JSON = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "alerta-incendios@tu-proyecto.iam.gserviceaccount.com",
  ...
}
'''
