# Plantilla de secrets para el despliegue de esta app en Streamlit Community Cloud. Copia este
# archivo a `secrets.toml` (mismo directorio) para probar en local, o pega su contenido en el
# panel "Secrets" del despliegue. `secrets.toml` real esta en .gitignore - nunca lo commitees.
#
# Este repo NO tiene ninguna credencial de base de datos ni acceso a la BD de produccion: la app
# lee los ranchos/clientes de un snapshot (RANCHOS_SNAPSHOT_B64 mas abajo), generado aparte en el
# monorepo interno ixo-geospacial.

# Fuerza el modo snapshot (sin esto, por defecto intenta conectar a una BD que este repo no tiene)
RANCHOS_DATA_SOURCE = "snapshot"

# Snapshot de ranchos/clientes en base64 - Streamlit Community Cloud no tiene almacenamiento
# persistente propio, asi que el .gpkg viaja aqui como secret (nunca en el repo). Para generarlo
# y refrescarlo, desde el monorepo interno ixo-geospacial (side_projects/alerta_incendios):
#   1. python scripts/exportar_snapshot.py          (requiere acceso a la BD de produccion)
#   2. certutil -encode data/ranchos_snapshot.gpkg snapshot_b64.txt   (Windows)
#      o: base64 -w0 data/ranchos_snapshot.gpkg > snapshot_b64.txt    (Linux/Mac)
#   3. Pegar el contenido de snapshot_b64.txt aqui (quitando las lineas
#      "-----BEGIN CERTIFICATE-----"/"-----END CERTIFICATE-----" si usaste certutil).
RANCHOS_SNAPSHOT_B64 = '''
...
'''

# Cuenta de servicio de Google Earth Engine - necesaria porque el servidor desplegado no puede
# hacer `earthengine authenticate` de forma interactiva. Crear en Google Cloud Console > IAM >
# Cuentas de servicio, con el rol "Earth Engine Resource Viewer" sobre el proyecto GEE_PROJECT,
# y generar una clave JSON.
GEE_SERVICE_ACCOUNT_EMAIL = "alerta-incendios@tu-proyecto.iam.gserviceaccount.com"
GEE_SERVICE_ACCOUNT_KEY_JSON = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "alerta-incendios@tu-proyecto.iam.gserviceaccount.com",
  ...
}
'''

# MAP_KEY gratuita de NASA FIRMS (src/firms_api.py) - fuente preferente de hotspots (latencia
# <3h) sobre el espejo de Earth Engine (24-40h observado); si falta, la app cae a GEE sola.
# Se pide sin coste, solo con un email, en https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY = "tu_clave_aqui"

# Opcional: ID de una Google Sheet (el trozo de la URL entre /d/ y /edit) donde persistir el
# historial del ranking de riesgo (flechas de subida/bajada) entre reinicios del contenedor de
# Streamlit Community Cloud, que no tiene disco persistente propio - ver src/rank_history.py.
# Sin esto, el ranking sigue funcionando pero se resetea (todo "Nuevo") cada vez que el
# contenedor se reinicia (duerme por inactividad o se redespliega).
#
# Reutiliza la MISMA cuenta de servicio de arriba (GEE_SERVICE_ACCOUNT_EMAIL/KEY_JSON), no hace
# falta crear una nueva. Pasos:
#   1. Habilitar "Google Sheets API" en el mismo proyecto de GCP (Google Cloud Console > APIs y
#      servicios > Habilitar APIs y servicios > buscar "Google Sheets API" > Habilitar).
#   2. Crear una Google Sheet vacia cualquiera (el nombre no importa, la app crea sola la
#      pestaña "ranking_historial" la primera vez que escribe).
#   3. Compartir esa hoja con el email de GEE_SERVICE_ACCOUNT_EMAIL, con permiso de Editor.
#   4. Pegar aqui el ID de su URL: https://docs.google.com/spreadsheets/d/ESTE_TROZO/edit
RANK_HISTORY_SHEET_ID = "tu_id_de_hoja_aqui"
